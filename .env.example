# Pulso TransMi API key -- get it from the student portal ("Mi API").
# Locally: put it in a real .env (gitignored). In CI: set it as a
# GitHub Actions secret named PTM_API_KEY, never commit it.
PTM_API_KEY=

# Optional: direct Postgres connection string to the team's Supabase
# project (Project Settings -> Database -> Connection string). Only needed
# for traceability logging (pipeline_runs, predictions, model_state,
# validation_metrics) and for train.py, which reads its training data from
# here. The submission pipeline still works without it.
SUPABASE_DB_URL=
